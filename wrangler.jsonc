{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "better-call-shell",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
